# Copy to .env for local runs. .env is gitignored. In CI these come from repository secrets.

# Public demo credentials (published by each site; kept out of code anyway)
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=
PARABANK_USERNAME=
PARABANK_PASSWORD=
INVENTREE_USERNAME=
INVENTREE_PASSWORD=

# Alerting (optional locally; without them, alerts are only logged)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# GITHUB_TOKEN and GITHUB_REPOSITORY are provided by GitHub Actions
